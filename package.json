{
  "name": "voidlauncher",
  "version": "0.4.0",
  "description": "Desktop launcher and updater for online-fix.me games",
  "homepage": "https://github.com/MrOz59/of-client-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrOz59/of-client-launcher.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build:preload": "node build-preload.js",
    "dev:renderer": "vite",
    "dev:main": "npm run build:preload && tsc -p tsconfig.build.json && ELECTRON_RUN_AS_NODE= NODE_ENV=development OF_ALLOW_TORRENT_FALLBACK=1 npx electron dist/main/main.js --disable-gpu --disable-features=VizDisplayCompositor",
    "dev": "npm run build:preload && concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "torrent:deps": "node scripts/install-torrent-agent-deps.js",
    "bundle:torrent-agent": "node scripts/build-torrent-agent.js",
    "bundle:torrent-agent-runtime": "node scripts/build-torrent-agent-runtime.js",
    "build:game-overlay": "node scripts/build-game-overlay.js",
    "build:notification-overlay:linux": "npm --prefix notification-overlay run build:linux",
    "build:notification-overlay:windows": "npm --prefix notification-overlay run build:windows",
    "fetch:ludusavi": "node scripts/fetch-ludusavi.js",
    "fetch:legendary": "node scripts/fetch-legendary.js",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build:app": "npm run build:preload && npm run typecheck:renderer && vite build && tsc -p tsconfig.build.json",
    "build": "npm run bundle:torrent-agent && npm run bundle:torrent-agent-runtime && npm run build:app",
    "dist:linux": "npm run fetch:easytier && npm run fetch:ludusavi && npm run fetch:legendary && npm run build:notification-overlay:linux && node scripts/patch-electron-builder.js && npm run build && electron-builder --linux --publish never",
    "dist:appimage": "npm run fetch:easytier && npm run fetch:ludusavi && npm run fetch:legendary && npm run build:notification-overlay:linux && node scripts/patch-electron-builder.js && npm run build && electron-builder --linux appimage --publish never",
    "dist:rpm": "npm run fetch:easytier && npm run fetch:ludusavi && npm run fetch:legendary && npm run build:notification-overlay:linux && node scripts/patch-electron-builder.js && npm run build && electron-builder --linux rpm --publish never",
    "dist:pacman": "npm run fetch:easytier && npm run fetch:ludusavi && npm run fetch:legendary && npm run build:notification-overlay:linux && node scripts/patch-electron-builder.js && npm run build && electron-builder --linux pacman --publish never",
    "dist:win": "node scripts/fetch-easytier.js --windows && npm run fetch:ludusavi && npm run fetch:legendary && npm run build:notification-overlay:windows && npm run build && electron-builder --win --publish never",
    "start": "electron .",
    "test:scraper": "node scripts/test-scraper-dist.js",
    "test:store-parser": "tsc -p tsconfig.build.json && node scripts/test-store-parser.js",
    "test:store-comments": "tsc -p tsconfig.build.json && node --test scripts/test-store-comments.js",
    "test:security": "tsc -p tsconfig.build.json && node --test scripts/test-cookie-security.js",
    "test:exe-detection": "tsc -p tsconfig.build.json && node scripts/test-exe-detection.js",
    "test:prefix": "tsc -p tsconfig.build.json && node --test scripts/test-prefix-lifecycle.js",
    "test:release-assets": "tsc -p tsconfig.build.json && node scripts/test-release-assets.js",
    "fixes:index": "node scripts/build-fixes-index.js",
    "fixes:check": "node scripts/build-fixes-index.js --check",
    "version:show": "node -p \"require('./package.json').version\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:beta": "npm version prerelease --preid=beta --no-git-tag-version",
    "version:preminor": "npm version preminor --preid=beta --no-git-tag-version",
    "version:rc": "npm version prerelease --preid=rc --no-git-tag-version",
    "postinstall": "electron-builder install-app-deps",
    "fetch:easytier": "node scripts/fetch-easytier.js",
    "test:vpn": "tsc -p tsconfig.build.json && node --test scripts/test-vpn.js scripts/test-vpn-controller.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.17.3",
    "7zip-bin-full": "^25.1.2",
    "axios": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0-rc.12",
    "electron-is-dev": "^2.0.0",
    "googleapis": "^180.0.0",
    "hls.js": "^1.7.2",
    "lucide-react": "^0.560.0",
    "node-7z": "^2.0.5",
    "node-unrar-js": "^2.0.2",
    "open": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "optionalDependencies": {
    "archiver": "^7.0.1",
    "fs-extra": "^11.1.1"
  },
  "build": {
    "appId": "me.voidlauncher.app",
    "productName": "VoidLauncher",
    "icon": "icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-preload/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "src/renderer/i18n/translations",
        "to": "i18n/translations",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "services/torrent-agent/torrent-agent",
        "to": "torrent-agent",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "services/torrent-agent/libtorrent_rpc.py",
        "to": "torrent-agent/libtorrent_rpc.py"
      },
      {
        "from": "services/torrent-agent/pydeps",
        "to": "torrent-agent/pydeps",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "services/torrent-agent/python",
        "to": "torrent-agent/python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/ludusavi",
        "to": "ludusavi",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/legendary",
        "to": "legendary",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "notification-overlay/dist",
        "to": "void-toast",
        "filter": [
          "void-toast-*"
        ]
      },
      {
        "from": "resources/notification.html",
        "to": "notification.html"
      },
      {
        "from": "resources/notifications",
        "to": "notifications",
        "filter": [
          "*.wav"
        ]
      },
      {
        "from": "vendor/easytier",
        "to": "easytier",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/vpn",
        "to": "vpn",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/7zip-bin-full/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Game",
      "maintainer": "Chaos Factory Team <contato@mroz.dev.br>",
      "icon": "icon.png",
      "executableName": "voidlauncher"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
